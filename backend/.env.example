# Copy to .env to override the defaults. Every setting here is optional.

# Message understanding falls back to the keyword extractor when no key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used to sign login tokens. Set a long random value anywhere the app is public.
RESQ_SECRET=

# 1 turns on the demo tools: SMS simulator page, driver demo PIN, and the on-screen
# one-time code (the code is only shown while SMS_PROVIDER is demo).
DEMO_OTP=1

# demo = send nothing | android = SMS Gateway for Android app | fast2sms = paid gateway
SMS_PROVIDER=demo
ANDROID_SMS_URL=
ANDROID_SMS_USER=
ANDROID_SMS_PASS=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp

# Secret the SMS gateway sends with inbound messages (X-SMS-Secret header or ?key=).
SMS_SECRET=demo-sms-secret
DRIVER_PIN=1234

# auto uses the downloaded OpenStreetMap data if present, otherwise the demo grid.
# Other values: osm, synthetic.
MAP_MODE=auto

# 1 loads sample reports when the database is empty.
AUTOSEED=0
